#!/usr/bin/env python3
"""a list of labelled countdowns to a date and time.
"""

import json
import math
import os
import sys
import time
import uuid
from datetime import datetime, timedelta

os.environ["GTK_CSD"] = "0"

import gi
from gi.repository import GLib
# Before GTK loads: GDK derives WM_CLASS from these at init.
GLib.set_prgname("countdowns")
GLib.set_application_name("Countdowns")
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, Gtk  # noqa: E402

APP_ID = "io.github.joakee.Countdowns"
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME")
                        or os.path.expanduser("~/.local/share"), "countdowns")
DATA = os.path.join(DATA_DIR, "countdowns.json")
RESPONSE_DELETE = 1

CSS = b"""
.large-title  { font-size: 22pt; font-weight: bold; }
.cd-time      { font-size: 26pt; font-weight: 300; }
.cd-sub       { font-size: 10pt; }
.cd-row       { padding: 8px 14px; }
.off .cd-time, .off .cd-sub { opacity: 0.45; }
.passed .cd-time { opacity: 0.6; }
.cd-remove    { min-width: 22px; min-height: 22px; padding: 0; border-radius: 999px; }
.empty        { font-size: 13pt; opacity: 0.5; }
"""


# ── storage ───────────────────────────────────────────────────

def load():
    try:
        with open(DATA) as f:
            doc = json.load(f)
        items = doc.get("countdowns", [])
        for it in items:
            datetime.fromisoformat(it["target"])   # validate
        return items
    except FileNotFoundError:
        return []
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        # Never silently overwrite a file we failed to read: park it aside.
        bad = DATA + ".bad"
        try:
            os.replace(DATA, bad)
            print(f"countdowns: unreadable data ({e}); moved to {bad}",
                  file=sys.stderr)
        except OSError:
            pass
        return []


def save(items):
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp = DATA + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"countdowns": items}, f, indent=2)
        f.write("\n")
    os.replace(tmp, DATA)   # atomic;  the conky card never reads half a file


def target_ts(item):
    return datetime.fromisoformat(item["target"]).timestamp()


def fmt_remaining(secs):
    """12d 04:32:10 / 04:32:10. Rounded up, so it reads 00:00:00 at the target."""
    s = max(0, math.ceil(secs))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    hms = f"{h:02}:{m:02}:{s:02}"
    return f"{d}d {hms}" if d else hms


def fmt_target(item):
    t = datetime.fromisoformat(item["target"])
    return t.strftime("%a %-d %b %Y, %H:%M")


# ── a row in the list ─────────────────────────────────────────

class Row(Gtk.ListBoxRow):
    def __init__(self, win, item):
        super().__init__()
        self.win, self.item = win, item
        self.get_style_context().add_class("cd-row")

        box = Gtk.Box(spacing=12)
        self.add(box)

        # ⊖ slides in from the left in edit mode, as on iOS.
        remove = Gtk.Button.new_from_icon_name("list-remove-symbolic",
                                               Gtk.IconSize.MENU)
        remove.set_valign(Gtk.Align.CENTER)
        for c in ("cd-remove", "destructive-action"):
            remove.get_style_context().add_class(c)
        remove.set_tooltip_text("Delete")
        remove.connect("clicked", lambda *_: self.arm_delete(True))
        self.remove_rev = Gtk.Revealer(
            transition_type=Gtk.RevealerTransitionType.SLIDE_RIGHT,
            transition_duration=180)
        self.remove_rev.add(remove)
        box.pack_start(self.remove_rev, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.time = Gtk.Label(xalign=0)
        self.time.get_style_context().add_class("cd-time")
        self.sub = Gtk.Label(xalign=0, ellipsize=3)   # PANGO_ELLIPSIZE_END
        self.sub.get_style_context().add_class("cd-sub")
        text.pack_start(self.time, False, False, 0)
        text.pack_start(self.sub, False, False, 0)
        box.pack_start(text, True, True, 0)

        # Right side: the switch normally, a chevron in edit mode, and a red
        # "Delete" once ⊖ has been pressed.
        self.right = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=150)
        self.switch = Gtk.Switch(active=item.get("enabled", True),
                                 valign=Gtk.Align.CENTER)
        self.switch.set_tooltip_text("Show on the desktop widget")
        self.switch.connect("notify::active", self.on_switch)
        chevron = Gtk.Image.new_from_icon_name("go-next-symbolic",
                                               Gtk.IconSize.MENU)
        confirm = Gtk.Button(label="Delete", valign=Gtk.Align.CENTER)
        confirm.get_style_context().add_class("destructive-action")
        confirm.connect("clicked", lambda *_: win.delete(item["id"]))
        self.right.add_named(self.switch, "switch")
        self.right.add_named(chevron, "chevron")
        self.right.add_named(confirm, "confirm")
        box.pack_end(self.right, False, False, 0)

        self.show_all()
        self.set_editing(win.editing, animate=False)
        self.refresh()

    def on_switch(self, sw, _):
        self.item["enabled"] = sw.get_active()
        self.refresh()
        self.win.commit()

    def set_editing(self, on, animate=True):
        self.remove_rev.set_transition_duration(180 if animate else 0)
        self.remove_rev.set_reveal_child(on)
        self.right.set_visible_child_name("chevron" if on else "switch")

    def arm_delete(self, on):
        self.right.set_visible_child_name("confirm" if on else "chevron")

    def refresh(self, now=None):
        now = time.time() if now is None else now
        left = target_ts(self.item) - now
        ctx = self.get_style_context()
        (ctx.remove_class if self.item.get("enabled", True) else ctx.add_class)("off")
        (ctx.add_class if left <= 0 else ctx.remove_class)("passed")
        self.time.set_markup('<span font_features="tnum">%s</span>'
                             % (fmt_remaining(left) if left > 0 else "Passed"))
        label = self.item.get("label") or "Countdown"
        self.sub.set_text(f"{label} · {fmt_target(self.item)}")


# ── add / edit ────────────────────────────────────────────────

class Editor(Gtk.Dialog):
    def __init__(self, parent, item=None):
        # use_header_bar=0: buttons go in a plain action area and the WM
        # decorates the dialog, whatever gtk-dialogs-use-header says.
        super().__init__(title="Edit Countdown" if item else "Add Countdown",
                         transient_for=parent, modal=True, use_header_bar=0,
                         destroy_with_parent=True)
        self.set_resizable(False)

        if item:
            target = datetime.fromisoformat(item["target"])
        else:   # the next whole hour
            target = (datetime.now() + timedelta(hours=1)).replace(
                minute=0, second=0, microsecond=0)

        if item:
            delete = self.add_button("Delete", RESPONSE_DELETE)
            delete.get_style_context().add_class("destructive-action")
            self.get_action_area().set_child_secondary(delete, True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        ok = self.add_button("Save", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        self.set_default_response(Gtk.ResponseType.OK)

        grid = Gtk.Grid(row_spacing=10, column_spacing=12,
                        margin=16, margin_bottom=8)
        self.get_content_area().add(grid)

        grid.attach(Gtk.Label(label="Label", xalign=1), 0, 0, 1, 1)
        self.entry = Gtk.Entry(text=item.get("label", "") if item else "",
                               placeholder_text="Countdown",
                               activates_default=True, hexpand=True)
        grid.attach(self.entry, 1, 0, 1, 1)

        self.cal = Gtk.Calendar()
        self.cal.select_month(target.month - 1, target.year)
        self.cal.select_day(target.day)
        self.cal.connect("day-selected", self.update_preview)
        self.cal.connect("day-selected-double-click",
                         lambda *_: self.response(Gtk.ResponseType.OK))
        grid.attach(Gtk.Label(label="Date", xalign=1, valign=Gtk.Align.START),
                    0, 1, 1, 1)
        grid.attach(self.cal, 1, 1, 1, 1)

        tbox = Gtk.Box(spacing=4)
        self.hour = self.spin(23, target.hour)
        self.minute = self.spin(59, target.minute)
        tbox.pack_start(self.hour, False, False, 0)
        tbox.pack_start(Gtk.Label(label=":"), False, False, 0)
        tbox.pack_start(self.minute, False, False, 0)
        grid.attach(Gtk.Label(label="Time", xalign=1), 0, 2, 1, 1)
        grid.attach(tbox, 1, 2, 1, 1)

        self.preview = Gtk.Label(xalign=0)
        self.preview.get_style_context().add_class("dim-label")
        grid.attach(self.preview, 1, 3, 1, 1)
        self.update_preview()

        self.show_all()
        self.entry.grab_focus()

    def spin(self, upper, value):
        s = Gtk.SpinButton.new_with_range(0, upper, 1)
        s.set_wrap(True)
        s.set_numeric(True)
        s.set_width_chars(2)
        s.set_value(value)
        s.set_activates_default(True)

        def two_digits(sb):
            sb.set_text(f"{int(sb.get_value()):02}")
            return True
        s.connect("output", two_digits)
        s.connect("value-changed", self.update_preview)
        return s

    def target(self):
        y, m0, d = self.cal.get_date()
        return datetime(y, m0 + 1, d,
                        self.hour.get_value_as_int(),
                        self.minute.get_value_as_int())

    def update_preview(self, *_):
        if not hasattr(self, "preview"):
            return
        left = self.target().timestamp() - time.time()
        self.preview.set_text(f"in {fmt_remaining(left)}" if left > 0
                              else "That time has already passed")

    def values(self):
        return {"label": self.entry.get_text().strip(),
                "target": self.target().isoformat(timespec="minutes")}


# ── main window ───────────────────────────────────────────────

class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Countdowns")
        self.set_default_size(400, 560)
        self.set_icon_name("alarm-symbolic")
        self.editing = False
        self.items = load()
        self.last_written = None

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)

        # The iOS nav bar, as ordinary widgets inside the window.
        bar = Gtk.Box(margin=8, margin_bottom=0)
        self.edit_btn = Gtk.Button(label="Edit", relief=Gtk.ReliefStyle.NONE)
        self.edit_btn.connect("clicked", lambda *_: self.set_editing(not self.editing))
        add = Gtk.Button.new_from_icon_name("list-add-symbolic", Gtk.IconSize.BUTTON)
        add.set_relief(Gtk.ReliefStyle.NONE)
        add.set_tooltip_text("Add countdown (Ctrl+N)")
        add.connect("clicked", lambda *_: self.edit(None))
        bar.pack_start(self.edit_btn, False, False, 0)
        bar.pack_end(add, False, False, 0)
        outer.pack_start(bar, False, False, 0)

        title = Gtk.Label(label="Countdowns", xalign=0, margin_start=14,
                          margin_bottom=6)
        title.get_style_context().add_class("large-title")
        outer.pack_start(title, False, False, 0)

        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list.set_header_func(self.separator)
        self.list.connect("row-activated", lambda _, row: self.on_activate(row))
        empty = Gtk.Label(label="No Countdowns")
        empty.get_style_context().add_class("empty")
        empty.show()
        self.list.set_placeholder(empty)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.add(self.list)
        outer.pack_start(Gtk.Separator(), False, False, 0)
        outer.pack_start(scroll, True, True, 0)

        self.connect("key-press-event", self.on_key)
        self.rebuild()
        self.show_all()

        # Pick up edits made elsewhere (another instance, a text editor).
        self.monitor = Gio.File.new_for_path(DATA).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self.on_file_changed)

        self.tick()

    @staticmethod
    def separator(row, before):
        if before and not row.get_header():
            row.set_header(Gtk.Separator())

    def rebuild(self):
        for r in self.list.get_children():
            r.destroy()
        for it in sorted(self.items, key=target_ts):
            self.list.add(Row(self, it))
        self.edit_btn.set_sensitive(bool(self.items) or self.editing)

    def commit(self):
        save(self.items)
        with open(DATA) as f:
            self.last_written = f.read()

    def tick(self):
        now = time.time()
        for r in self.list.get_children():
            r.refresh(now)
        # Re-arm on the next second boundary so the digits change in step
        # with the clock (and with the conky card) rather than drifting.
        GLib.timeout_add(int((1 - now % 1) * 1000) + 5, self.tick)
        return False

    def set_editing(self, on):
        self.editing = on
        self.edit_btn.set_label("Done" if on else "Edit")
        for r in self.list.get_children():
            r.set_editing(on)
        self.edit_btn.set_sensitive(bool(self.items) or on)

    def on_activate(self, row):
        if self.editing and row.right.get_visible_child_name() == "confirm":
            row.arm_delete(False)
        else:
            self.edit(row.item)

    def edit(self, item):
        dlg = Editor(self, item)
        resp = dlg.run()
        vals = dlg.values()
        dlg.destroy()
        if resp == RESPONSE_DELETE and item:
            self.delete(item["id"])
            return
        if resp != Gtk.ResponseType.OK:
            return
        if item:
            item.update(vals)
        else:
            self.items.append({"id": uuid.uuid4().hex, **vals, "enabled": True})
        self.commit()
        self.rebuild()

    def delete(self, ident):
        self.items = [i for i in self.items if i["id"] != ident]
        self.commit()
        if not self.items:
            self.set_editing(False)
        self.rebuild()

    def on_key(self, _, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and ev.keyval in (Gdk.KEY_n, Gdk.KEY_N):
            self.edit(None)
        elif ctrl and ev.keyval in (Gdk.KEY_q, Gdk.KEY_w):
            self.close()
        elif ev.keyval == Gdk.KEY_Escape and self.editing:
            self.set_editing(False)
        else:
            return False
        return True

    def on_file_changed(self, *_):
        try:
            with open(DATA) as f:
                text = f.read()
        except OSError:
            return
        if text == self.last_written:
            return    # our own write coming back
        self.last_written = text
        self.items = load()
        self.rebuild()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if not self.win:
            self.win = Window(self)
        self.win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
